{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.ts": {
      "includeFiles": "data/**",
      "maxDuration": 60,
      "memory": 1024
    },
    "api/analyze-project.ts": {
      "includeFiles": "data/**",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/analyze-project",
      "destination": "/api/analyze-project"
    },
    {
      "source": "/api/analyze-project/(.*)",
      "destination": "/api/analyze-project"
    },
    {
      "source": "/analyze-project",
      "destination": "/api/analyze-project"
    },
    {
      "source": "/analyze-project/(.*)",
      "destination": "/api/analyze-project"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
