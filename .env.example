# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP configuration (Opcional - para envio real de e-mails de recuperação e login):
# SMTP_HOST: Servidor SMTP do seu provedor (Ex: smtp.gmail.com ou smtp.office365.com). NÃO coloque e-mail ou senha aqui.
SMTP_HOST=
# SMTP_PORT: Porta do servidor (587 para TLS/STARTTLS ou 465 para SSL)
SMTP_PORT=587
# SMTP_USER: Endereço de e-mail do remetente (Ex: seu-email@gmail.com)
SMTP_USER=
# SMTP_PASS: Senha de aplicativo gerada pelo provedor (No Gmail: Senha de App de 16 caracteres)
SMTP_PASS=
# SMTP_FROM: Nome de exibição e e-mail remetente
SMTP_FROM=

# Upstash Redis / Vercel KV (Persistência distribuída para Vercel Serverless)
# UPSTASH_REDIS_REST_URL: URL REST do banco Upstash Redis (Ex: https://xxx.upstash.io)
UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN: Token de autenticação REST do Upstash Redis
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash (Mensageria e Webhooks Assíncronos para Serverless)
# QSTASH_TOKEN: Token de publicação para enfileirar mensagens via QStash API
QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY: Chave de validação de assinatura do webhook QStash
QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY: Chave secundária para rotação de segredos sem downtime
QSTASH_NEXT_SIGNING_KEY=

